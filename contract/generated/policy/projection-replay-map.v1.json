  "stream_end": {
    "RUN_TERMINAL": "fetch final required snapshots and do not reconnect indefinitely",
    "SERVER_SHUTDOWN": "refresh gateway state and reconnect from the last committed cursor",
    "SLOW_CONSUMER": "RESOURCE_EXHAUSTED typed error; refresh affected Run and resume from the last committed cursor",
    "TRANSPORT_FAILURE": "never interpret as Run failure"
  }
