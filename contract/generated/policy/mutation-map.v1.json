      "owner": "RuntimeService.InspectWorkspace",
      "idempotency": "Read",
      "retry": "Bounded repeat",
      "reconciliation": "Repeat same path/expected-ID mode"
    },
    {
      "operation": "ListProfiles",
      "owner": "RuntimeService.ListProfiles",
