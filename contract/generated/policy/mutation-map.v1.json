      "same_key_replay": "not_applicable",
      "lost_response": "inspect_workspace_run_absence_and_prior_confirmation",
      "automatic_retry": "forbidden"
    },
    {
      "rpc": "RunService.RecoverRun",
      "cli": "run.recover",
      "idempotency": "tokenless",
      "identity": [
        "run",
        "controller_identity_generation",
        "expected_state_revision"
      ],
      "same_key_replay": "not_applicable",
      "lost_response": "get_run_then_reconcile",
      "automatic_retry": "forbidden"
    },
    {
      "rpc": "RunService.ReconcileRun",
      "cli": "run.reconcile",
      "idempotency": "tokenless",
      "identity": [
        "run",
        "controller_identity_generation",
        "expected_state_revision"
      ],
      "same_key_replay": "not_applicable",
      "lost_response": "get_run_before_new_reconcile",
      "automatic_retry": "forbidden"
    },
    {
      "rpc": "WriterService.AcquireWriter",
      "cli": "run.acquire_write",
      "idempotency": "tokenless",
      "identity": [
        "run",
        "controller_identity_generation",
        "expected_state_revision"
      ],
      "same_key_replay": "not_applicable",
      "lost_response": "get_workspace_writer_status_and_get_run",
      "automatic_retry": "forbidden"
    },
    {
      "rpc": "WriterService.ReleaseWriter",
