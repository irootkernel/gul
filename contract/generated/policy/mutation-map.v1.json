      "automatic_retry": "forbidden"
    },
    {
      "rpc": "RunService.ResumeRun",
      "cli": "run.resume",
      "idempotency": "tokenless",
      "identity": [
        "run",
        "controller_identity_generation",
        "expected_state_revision"
      ],
      "same_key_replay": "not_applicable",
      "lost_response": "get_run_and_reconcile_if_required",
      "automatic_retry": "forbidden"
    },
    {
      "rpc": "RunService.CloseRun",
      "cli": "run.close",
      "idempotency": "tokenless",
      "identity": [
        "run",
        "controller_identity_generation",
