{
  "schema_version": 1,
  "transparent_grpc_retries": false,
  "upstream": [
    {
      "rpc": "RunService.StartRun",
      "cli": "run.start",
      "idempotency": "required",
      "identity": [
        "canonical_workspace_identity",
        "controller_id_generation",
        "control_mode",
        "accepted_profile_snapshot",
        "purpose_kind_label",
        "effective_model",
        "current_default_effort",
        "execution_lane",
        "required_assurance",
        "sorted_unique_required_capabilities",
        "parent_reference",
        "controller_instructions_byte_length_sha256"
      ],
      "same_key_replay": "return_original_run",
      "lost_response": "repeat_exact_key",
      "different_controller": "idempotency_conflict",
      "different_normalized_request": "idempotency_conflict",
      "retention": "workspace_lifetime_no_ttl_with_deleted_run_tombstone",
      "deleted_run_replay": "run_not_found_with_original_run_id_never_allocate",
      "secondary_reconciliation": "list_runs_by_unique_controller_id",
      "automatic_retry": "forbidden"
    },
    {
      "rpc": "RunService.ForkRun",
      "cli": "run.fork",
      "idempotency": "required",
      "identity": [
        "source_run",
        "controller_identity_generation",
        "fork_mode",
        "model",
        "history_or_provenance_boundary"
      ],
      "same_key_replay": "return_original_run",
      "lost_response": "repeat_exact_key",
      "automatic_retry": "forbidden"
    },
    {
      "rpc": "RunService.SubmitTurn",
      "cli": "run.submit",
      "idempotency": "required",
      "identity": [
        "run",
        "controller_identity_generation",
        "message_bytes",
        "ordered_image_metadata_digests",
        "model_effort",
        "write_intent_turn_options"
      ],
      "same_key_replay": "return_original_accepted_turn",
      "lost_response": "get_run_then_repeat_exact_key_or_reconcile",
      "automatic_retry": "forbidden"
    },
    {
      "rpc": "InteractionService.ResolveInteraction",
      "cli": "run.respond",
      "idempotency": "required",
      "identity": [
        "run",
        "interaction",
        "controller_identity_generation",
        "normalized_nonsecret_response_or_secret_first_success"
      ],
      "same_key_replay": "return_original_resolution_receipt",
      "lost_response": "refetch summary and authorized interaction; resolved means complete; pending protected input requires explicit user re-entry; indeterminate state is interaction_outcome_unknown",
      "protected_input_replay": "forbidden",
      "protected_input_persistence": "forbidden",
      "winning_secret_key_replay": "return_receipt_without_comparing_or_replaying_body",
      "automatic_retry": "forbidden"
    },
    {
      "rpc": "RunService.CreateWriteContinuation",
      "cli": "run.create_write_continuation",
      "idempotency": "required",
      "identity": [
        "source_run_turn",
        "creation_reason",
        "purpose",
        "model_effort",
        "assurance_capabilities",
        "handoff_instruction_digests",
        "ordered_artifact_refs",
        "destination_controller_identity_generation"
      ],
      "same_key_replay": "return_original_destination_run",
      "lost_response": "repeat_exact_key",
      "automatic_retry": "forbidden"
    },
    {
      "rpc": "RunService.InterruptTurn",
      "cli": "run.interrupt",
      "idempotency": "tokenless",
      "identity": [
        "run",
        "controller_identity_generation",
        "expected_state_revision"
      ],
      "same_key_replay": "not_applicable",
      "lost_response": "get_run_and_reconcile_if_outcome_unknown",
      "automatic_retry": "forbidden"
    },
    {
      "rpc": "RunService.SetDefaultEffort",
