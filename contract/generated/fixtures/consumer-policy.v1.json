        "same_key_replay": "return_original_destination_run",
        "lost_response": "repeat_exact_key",
        "automatic_retry": "forbidden"
      },
      "RunService.InterruptTurn": {
        "rpc": "RunService.InterruptTurn",
        "cli": "run.interrupt",
        "idempotency": "tokenless",
        "identity": [
          "run",
          "controller_identity_generation",
          "expected_state_revision"
