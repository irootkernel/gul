  "projection_convergence": [
    {
      "name": "equal-complete-stamps",
      "run": 7,
      "writer": 7,
      "interaction": 7,
      "floor": 7,
      "enables": true
    },
    {
      "name": "writer-behind-floor",
      "run": 8,
      "writer": 7,
      "interaction": 8,
      "floor": 8,
      "enables": false
    },
    {
      "name": "partial-event-disable-only",
      "run": 9,
      "writer": null,
      "interaction": 9,
      "floor": 9,
      "enables": false
    },
    {
      "name": "timeline-head-behind",
      "run": 10,
      "writer": 10,
      "interaction": 10,
      "floor": 10,
      "timeline_head": 9,
      "enables": false
    }
  ],
  "stream_end": {
    "RUN_TERMINAL": "fetch final required snapshots and do not reconnect indefinitely",
    "SERVER_SHUTDOWN": "refresh gateway state and reconnect from the last committed cursor",
    "SLOW_CONSUMER": "RESOURCE_EXHAUSTED typed error; refresh affected Run and resume from the last committed cursor",
    "TRANSPORT_FAILURE": "never interpret as Run failure"
  },
  "event_invalidation_variants": [
    "RunStateChanged",
    "TurnStateChanged",
    "FinalResponseAvailable",
    "InteractionOpened",
    "InteractionResolved",
    "WriterStateChanged",
    "RecoveryRequired",
    "RuntimeErrorOccurred",
    "GenerationChanged",
    "WorkspaceChanges",
    "CommandStarted",
    "CommandCompleted",
    "UsageReported",
    "DiagnosticReported",
    "ReasoningSuppressed",
    "RunEventHeartbeat",
    "RunEventStreamEnd(RUN_TERMINAL)",
    "RunEventStreamEnd(SERVER_SHUTDOWN)",
    "typed gRPC SLOW_CONSUMER",
    "other transport failure"
  ],
  "unsupported_rpcs": [
    "RuntimeService.ListProfileDiagnostics",
    "RunService.SetDefaultEffort",
    "RunService.ForkRun",
    "RunService.VerifyRun",
    "WriterService.PrepareWriterHandoff",
    "WriterService.CommitWriterHandoff",
    "WriterService.CancelWriterHandoff"
  ],
  "production_cli_fallback": false,
  "unknown_required_enum": "reject",
  "unknown_optional_field": "preserve_only_when_allowlisted"
}
